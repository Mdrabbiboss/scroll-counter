<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ads (AdMob) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Daily limit / 80% warning notifications (Android 13+ asks the user) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- History backup file in shared storage, so "Clear data" / uninstall can't wipe the counts -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Lets the app see whether each supported social app is installed (no QUERY_ALL_PACKAGES needed) -->
    <!-- Lets the app see which launcher apps / browsers are installed, so only installed apps are listed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:backupAgent=".data.ScrollBackupAgent"
        android:restoreAnyVersion="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_app"
        android:roundIcon="@mipmap/ic_app_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScrollCounter">

        <!-- AdMob App ID: TEST id. Replace with your own before publishing. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScrollCounter.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shown when the daily limit is reached and the user is sent out of a social app. -->
        <activity
            android:name=".block.BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.rabbi.scrollcounter.block" />

        <!-- Home-screen widget -->
        <receiver
            android:name=".widget.ScrollWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scroll_widget_info" />
        </receiver>

        <!-- Scroll detection. Only the system can bind to it (BIND_ACCESSIBILITY_SERVICE). -->
        <!-- "Prevent app uninstall" (device admin with no policies) -->
        <receiver
            android:name=".guard.AdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:description="@string/admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tracker.ScrollTrackerService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/scroll_tracker_config" />
        </service>
    </application>
</manifest>

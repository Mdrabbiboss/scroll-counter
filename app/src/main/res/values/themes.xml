<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScrollCounter" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <!-- Shown instantly while the app starts: the mascot on deep teal, no blank screen. -->
    <style name="Theme.ScrollCounter.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/sc_app_icon_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ScrollCounter</item>
    </style>
</resources>

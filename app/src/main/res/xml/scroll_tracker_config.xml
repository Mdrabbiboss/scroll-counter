<?xml version="1.0" encoding="utf-8"?>
<!-- Listens in every app (so reels are counted in any social / video app and in browsers). It looks at the screen LAYOUT
     (sizes and view ids) to recognise a Reels / Shorts feed; it never reads or stores text. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled|typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:description="@string/accessibility_description"
    android:summary="@string/accessibility_summary"
    android:settingsActivity="com.rabbi.scrollcounter.MainActivity"
    android:notificationTimeout="100" />
